# Pictures and fonts never change once published: let them cache for a year.
# HTML is left alone so edits show up immediately.
# Read by both Cloudflare Pages and Netlify.

/images/*
  Cache-Control: public, max-age=31536000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
