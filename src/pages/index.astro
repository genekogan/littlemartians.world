---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { homepage } from '../lib/content.js';

const page = homepage;
const hasHero = !!(page.sections[0]?.background || page.sections[0]?.backgroundVideo);
---
<Base title={page.title} description={page.description} ogImage={page.ogImage} path="/" hasHero={hasHero}>
  {page.sections.map((s, i) => <Section section={s} first={i === 0} />)}
</Base>
