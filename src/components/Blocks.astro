---
// Renders a list of content blocks using Squarespace's box model: every block
// carries 17px of padding, rows bleed -17px, and spacing comes from spacer
// blocks and element margins — not from per-component margins.
import { fixHref, isExternal } from '../lib/content.js';
const { blocks, eager = false } = Astro.props;
const cls = b => [b.align ? `ta-${b.align}` : '', b.size && b.type !== 'button' ? `sz-${b.size}` : ''].filter(Boolean).join(' ') || undefined;
const Self = Astro.self;

const extTarget = href => isExternal(href) ? '_blank' : undefined;
const extRel = href => isExternal(href) ? 'noopener' : undefined;
---
{(blocks ?? []).map((b) => {
  if (b.type === 'row') {
    const tracks = b.cols.reduce((a, c) => a + Math.max(1, c.span), 0) || 12;
    return (
      <div class="row" style={`--tracks:${tracks}`}>
        {b.cols.map((c) => (
          <div class="col" style={`--span:${Math.max(1, c.span)}`}>
            <Self blocks={c.content} eager={eager} />
          </div>
        ))}
      </div>
    );
  }

  if (b.type === 'spacer') return (
    <div class={b.ar != null ? 'blk blk--spacer blk--spacer-ar' : 'blk blk--spacer'} aria-hidden="true">
      {b.ar != null ? <div style={`padding-bottom:${b.ar}%`} /> : null}
    </div>
  );

  if (b.type === 'text') return (
    <div class="blk blk--text">
      {b.children.map((c) => {
        if (c.type === 'heading') {
          const H = `h${Math.min(Math.max(c.level, 1), 6)}`;
          return <H class={cls(c)} set:html={c.html} />;
        }
        if (c.type === 'list') {
          const L = c.ordered ? 'ol' : 'ul';
          return <L class={cls(c)}>{c.items.map((i) => <li set:html={i} />)}</L>;
        }
        if (c.type === 'quote') return <blockquote class={cls(c)} set:html={c.html} />;
        return <p class={cls(c)} set:html={c.html} />;
      })}
    </div>
  );

  if (b.type === 'heading') {
    const H = `h${Math.min(Math.max(b.level, 1), 6)}`;
    return <div class="blk blk--text"><H class={cls(b)} set:html={b.html} /></div>;
  }
  if (b.type === 'paragraph') return (
    <div class="blk blk--text"><p class={cls(b)} set:html={b.html} /></div>
  );
  if (b.type === 'list') {
    const L = b.ordered ? 'ol' : 'ul';
    return <div class="blk blk--text"><L class={cls(b)}>{b.items.map((i) => <li set:html={i} />)}</L></div>;
  }
  if (b.type === 'quote') return <div class="blk blk--text"><blockquote class={cls(b)} set:html={b.html} /></div>;
  if (b.type === 'divider') return <div class="blk blk--line"><hr /></div>;

  if (b.type === 'image') {
    const duo = ['card', 'collage'].includes(b.layout);
    if (duo) {
      const imgEl = b.aspect
        ? <div class="img-crop" style={`padding-bottom:${b.aspect}%`}><img src={b.src} alt={b.alt} loading="lazy" decoding="async" /></div>
        : <img src={b.src} alt={b.alt} width={b.width} height={b.height} loading="lazy" decoding="async" />;
      return (
        <div class="blk blk--image">
          <div class={`img-duo img-duo--${b.layout} img-duo--${b.position || 'left'}`}>
            <figure class="img-duo-media" style={b.mask ? `clip-path:${b.mask}` : undefined}>
              {b.link ? <a href={fixHref(b.link)} target={extTarget(b.link)} rel={extRel(b.link)}>{imgEl}</a> : imgEl}
            </figure>
            <div class="img-duo-card">
              {b.title && <p class="img-title">{b.title}</p>}
              {b.subtitle && <p class="img-subtitle">{b.subtitle}</p>}
              {b.description && <p class="img-desc">{b.description}</p>}
              {b.button?.text && <p class="card-btn-wrap"><a class="card-btn" href={fixHref(b.button.href)} target={extTarget(b.button.href)} rel={extRel(b.button.href)}>{b.button.text}</a></p>}
            </div>
          </div>
        </div>
      );
    }
    const overlay = b.layout === 'poster';
    const style = [
      b.mask ? `clip-path:${b.mask}` : '',
      overlay && b.aspect ? `padding-bottom:${b.aspect}%` : '',
    ].filter(Boolean).join(';') || undefined;
    const cropped = !overlay && b.aspect;
    const clip = b.mask ? `clip-path:${b.mask}` : '';
    const img = cropped
      ? (
        <div class="img-crop" style={[`padding-bottom:${b.aspect}%`, clip].filter(Boolean).join(';')}>
          <img src={b.src} alt={b.alt} width={b.width} height={b.height}
               loading={eager ? 'eager' : 'lazy'} decoding="async" />
        </div>
      )
      : (
        <img src={b.src} alt={b.alt} width={b.width} height={b.height}
             loading={eager ? 'eager' : 'lazy'} decoding="async"
             style={[!overlay && b.width && b.height ? `aspect-ratio:${b.width}/${b.height}` : '', clip].filter(Boolean).join(';') || undefined} />
      );
    if (overlay) {
      // Poster layout: content overlaid on the (possibly clipped) image.
      const card = (
        <figcaption class="poster-card">
          {b.title && <p class="poster-title">{b.title}</p>}
          {b.subtitle && <p class="poster-subtitle">{b.subtitle}</p>}
          {b.button?.text && <a class="poster-btn" href={fixHref(b.button.href)} target={extTarget(b.button.href)} rel={extRel(b.button.href)}>{b.button.text}</a>}
        </figcaption>
      );
      const body = <>{img}{card}</>;
      return (
        <div class="blk blk--image">
          <figure class="img-poster" style={style}>
            {b.link && !b.button?.text
              ? <a href={fixHref(b.link)} target={extTarget(b.link)} rel={extRel(b.link)}>{body}</a>
              : body}
          </figure>
        </div>
      );
    }
    return (
      <div class="blk blk--image">
        <figure class={b.mask ? "img-block img-block--masked" : "img-block"} style={b.width ? `max-width:` + b.width + `px` : undefined}>
          {b.link
            ? <a href={fixHref(b.link)} target={extTarget(b.link)} rel={extRel(b.link)}>{img}</a>
            : img}
          {(b.title || b.subtitle || b.button?.text) && (
            <figcaption class="img-card">
              {b.title && <p class="img-title">{b.title}</p>}
              {b.subtitle && <p class="img-subtitle">{b.subtitle}</p>}
              {b.button?.text && <p class="card-btn-wrap"><a class="card-btn" href={fixHref(b.button.href)} target={extTarget(b.button.href)} rel={extRel(b.button.href)}>{b.button.text}</a></p>}
            </figcaption>
          )}
          {b.caption && <figcaption class="img-caption" set:html={b.caption} />}
        </figure>
      </div>
    );
  }

  if (b.type === 'gallery') return (
    <div class="blk blk--gallery">
      <div class="gallery" style={`--per-row:${b.perRow || 4};--g-gap:${(b.padding ?? 20)}px`}>
        {b.images.map((im) => (
          <a class="g-item" href={im.src} target="_blank" rel="noopener">
            <img src={im.src} alt={im.alt} loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </div>
  );

  if (b.type === 'video') {
    const pad = b.ratio || 56.25;
    const vStyle = b.maxWidth ? `max-width:${b.maxWidth}px;margin:0 auto` : undefined;
    const player = b.poster
      ? (
        <div class="video" style={`padding-bottom:${pad}%`}>
          <button class="video-play" type="button"
                  data-video-src={`${b.src}${b.src.includes('?') ? '&' : '?'}autoplay=1`}
                  aria-label={`Play ${b.title || 'video'}`}>
            <img src={b.poster} alt="" loading="lazy" decoding="async" />
            <span class="video-play-icon" aria-hidden="true" />
          </button>
        </div>
      )
      : (
        <div class="video" style={`padding-bottom:${pad}%`}>
          <iframe src={b.src} title={b.title || 'Video'} frameborder="0" loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  referrerpolicy="strict-origin-when-cross-origin" allowfullscreen />
        </div>
      );
    return (
      <div class="blk blk--video">
        <div style={vStyle}>
          {b.caption
            ? <figure class="video-figure">{player}<figcaption set:html={b.caption} /></figure>
            : player}
        </div>
      </div>
    );
  }

  if (b.type === 'button') return (
    <div class={`blk blk--button btn-align--${b.align || 'center'}`}>
      <a class={`btn btn--${b.size || 'small'}`} href={fixHref(b.href)}
         target={extTarget(b.href)} rel={extRel(b.href)}>{b.text}</a>
    </div>
  );

  if (b.type === 'social') return (
    <div class="blk blk--social">
      <p class="social">{b.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.name || 'link'}</a>)}</p>
    </div>
  );

  if (b.type === 'form') return (
    <div class="blk blk--form">
      <form class="lm-form" data-needs-backend="true">
        {b.fields.map((f) => {
          const id = 'f-' + f.label.toLowerCase().replace(/[^a-z0-9]+/g, '-');
          return (
            <>
              <label for={id}>{f.label}</label>
              {f.type === 'textarea'
                ? <textarea id={id} name={f.label} rows="5" required={f.required} />
                : <input id={id} type={f.type} name={f.label} required={f.required} />}
            </>
          );
        })}
        <button type="submit">{b.button || 'Submit'}</button>
        <p class="form-note">Form submissions need a backend — not yet connected.</p>
      </form>
    </div>
  );

  if (b.type === 'embed') return <div class="blk blk--embed"><div class="embed" set:html={b.html} /></div>;
  return null;
})}
