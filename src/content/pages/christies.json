          {
           "type": "paragraph",
           "html": "<strong>Verdelia, Little Martian, at Christie’s ‘Augmented Intelligence’</strong> - 20th February to March 5th at the Rockefeller Center, NYC.",
           "align": "center",
           "size": null
          }
         ]
        },
        {
         "type": "button",
         "text": "Learn more",
         "href": "https://onlineonly.christies.com/s/augmented-intelligence/lots/3837",
         "size": "medium",
         "align": "center",
         "external": true
        },
        {
         "type": "image",
         "src": "assets/bda68ea7-b76e-42e9-8493-27123d4b3e64_IMG_1133.jpg",
         "alt": "",
         "width": 3024,
         "height": 3024,
         "caption": "",
         "title": null,
